        "### Prediction"
      ],
      "metadata": {
        "id": "69g1DbM1a9xu"
      },
      "id": "69g1DbM1a9xu"
    },
    {
      "cell_type": "code",
      "source": [
        "# Make prediction using the model\n",
        "pred_result= modelGNB.predict(x_test)"
      ],
      "metadata": {
        "id": "Gj1B2UeUzZ3I"
      },
      "id": "Gj1B2UeUzZ3I",
      "execution_count": 32,
