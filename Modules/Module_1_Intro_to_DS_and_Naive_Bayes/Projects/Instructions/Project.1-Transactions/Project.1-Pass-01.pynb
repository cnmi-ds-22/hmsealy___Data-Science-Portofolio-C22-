    {
      "cell_type": "markdown",
      "source": [
        "### Model"
      ],
      "metadata": {
        "id": "RUu2fhTlWMDy"
      },
      "id": "RUu2fhTlWMDy"
    },
    {
      "cell_type": "code",
      "source": [
        "# Create an empty GNB model\n",
        "modelGNB= GaussianNB()"
      ],
      "metadata": {
        "id": "DaMGHLmWa7a8"
      },
      "id": "DaMGHLmWa7a8",
      "execution_count": 30,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Fit"
      ],
      "metadata": {
        "id": "P_jsraIBa9h7"
      },
      "id": "P_jsraIBa9h7"
    },
    {
      "cell_type": "code",
      "source": [
        "# Train ( fit ) the model\n",
        "modelGNB.fit(x_train,y_train)"
      ],
