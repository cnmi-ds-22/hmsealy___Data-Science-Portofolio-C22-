    {
      "cell_type": "code",
      "source": [
        "# Display the correlation matrix\n",
        "\n",
        "plt.figure(figsize=(16, 12))\n",
        "sns.heatmap(transaction_df_target_feature.corr(),\n",
        "            annot=True,\n",
        "            cmap='coolwarm',  # blue = negative, red = positive\n",
        "            center=0,         # white = no correlation\n",
        "            vmin=-1, vmax=1)  # full correlation range\n",
        "plt.title('Correlation Matrix')\n",
        "plt.show()\n"
      ],
      "metadata": {
        "collapsed": true,
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 735
        },
        "id": "hoUTDjm9zdAX",
        "outputId": "51112e15-2cea-4cb6-c4ee-fadf75573cb9"
      },
      "id": "hoUTDjm9zdAX",
      "execution_count": 24,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1600x1200 with 2 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Calculate a correlation matrix (features only)\n",
        "transaction_df_features_only = transaction_df_target_feature[feature_cols]\n",
        "feature_corr = transaction_df_features_only.corr()\n",
        "\n",
        "plt.figure(figsize=(16, 12))\n",
        "sns.heatmap(feature_corr,\n",
        "            annot=True,\n",
        "            cmap='coolwarm',  # blue = negative, red = positive\n",
        "            center=0,         # white/gray = no correlation\n",
        "            vmin=-1, vmax=1)  # full correlation range\n",
        "plt.title('Correlation Matrix - Features Only')\n",
        "plt.show()\n",
        "\n",
        "#output- correlation between features are near 0\n",
        "#look independent, 2nd GNB assumption\n"
      ],
      "metadata": {
        "collapsed": true,
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 735
        },
        "id": "CiK41q7UJakI",
        "outputId": "0d9fca10-d85a-427e-e435-d81087e79955"
