    {
      "cell_type": "markdown",
      "source": [
        "## Data Processing"
      ],
      "metadata": {
        "id": "dtDSOVPKWCuQ"
      },
      "id": "dtDSOVPKWCuQ"
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Single Cross-validation"
      ],
      "metadata": {
        "id": "dvBpDqI3Xqq6"
      },
      "id": "dvBpDqI3Xqq6"
    },
    {
      "cell_type": "code",
      "source": [
        "# Split data from into target and features\n",
        "target =transaction_df_target['target'].copy()\n",
        "features= transaction_df_target_feature [feature_cols].copy()\n",
        "\n"
      ],
      "metadata": {
        "id": "OAjKPtIAYE8A"
      },
      "id": "OAjKPtIAYE8A",
      "execution_count": 27,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Train test split\n",
        "x_train, x_test, y_train, y_test = train_test_split( features, target, test_size=0.25, random_state=42)"
      ],
      "metadata": {
        "id": "LY3_sQ8tWMKi"
      },
      "id": "LY3_sQ8tWMKi",
      "execution_count": 28,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# verify shape of each data set from Train test split\n",
        "for i in (x_train, x_test,y_train,y_test):\n",
        "  print(i.shape)\n",
        "  print(type(i))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "collapsed": true,
        "id": "8AeoxbCTWMG5",
        "outputId": "e48d51d1-2157-4821-f141-672d7c50b63c"
      },
      "id": "8AeoxbCTWMG5",
      "execution_count": 29,
      "outputs": [
        {
          "output_type": "stream",
